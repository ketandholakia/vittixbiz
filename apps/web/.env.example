# Copy to apps/web/.env.local and adjust.
# (.env.local is gitignored; .env.example is committed as documentation.)

# Base URL of the NestJS API (apps/api). Defaults to http://localhost:3000
# when unset.
NEXT_PUBLIC_API_URL=http://localhost:3000

# KNOWN GAP: the API has no "list my organizations" endpoint yet, so the org
# id is taken from this env var. Replace with a real membership selector once
# the backend exposes the user's organizations.
NEXT_PUBLIC_ORG_ID=

# KNOWN GAP: the API has no list-GSTINs endpoint yet, so invoice creation uses
# this GSTIN id for the issuing branch. Replace with a real branch selector
# once the backend exposes org GSTINs.
NEXT_PUBLIC_GSTIN_ID=