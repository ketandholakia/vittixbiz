# Copy to apps/web/.env.local and adjust.
# (.env.local is gitignored; .env.example is committed as documentation.)

# Base URL of the NestJS API (apps/api). Defaults to http://localhost:3000
# when unset.
NEXT_PUBLIC_API_URL=http://localhost:3000

# NOTE: org and GSTIN selection no longer need env vars — the frontend
# discovers them from the API (GET /me/organizations and
# GET /organizations/:orgId/gstins) and persists the choice in localStorage.