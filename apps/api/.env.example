# PUPPETEER_SKIP_DOWNLOAD=true — set BEFORE running `pnpm install` in
# network-restricted environments so Puppeteer's postinstall skips the
# Chromium download. It is NOT a runtime env var, so do not add it to a
# runtime .env file — export it in the shell used to install dependencies.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vittixbiz
JWT_SECRET=super_secret_jwt_key_here